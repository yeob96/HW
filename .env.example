# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
#   cp .env.example .env

# ─────────── 백엔드 (Spring Boot) ───────────

# 공공데이터포털 서비스 키 — 온비드 공매 API 5종 + 국토교통부 실거래가 API 2종 공용
# https://www.data.go.kr 마이페이지 > 개발계정 > 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=

# 카카오 REST API 키 — 주소 → 좌표·법정동코드(b_code) 변환용 (카카오 로컬 API)
# 절대 프론트에 노출하지 않는다
KAKAO_REST_API_KEY=

# ─────────── DB (docker compose) ───────────

DB_NAME=gongmae
DB_USER=gongmae
DB_PASSWORD=gongmae
DB_HOST=localhost
DB_PORT=5432

# ─────────── 프론트엔드 (Vite) ───────────

# 카카오 JavaScript 키 — 지도 표시용.
# VITE_ 접두사가 붙은 값은 빌드 결과물에 그대로 들어간다. JavaScript 키만 넣고,
# REST 키나 공공데이터 키는 여기에 절대 넣지 않는다.
VITE_KAKAO_JS_KEY=

# 백엔드 주소. 비워 두면 Vite 개발 서버의 /api 프록시(→ localhost:8080)를 쓴다.
VITE_API_BASE_URL=
